      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.workspace { --page:#101216; --sidebar:#17191f; --panel:#1b1e25; --panel-soft:#20232b; --line:#30343d; --ink:#edeff4; --muted:#a3a8b3; --quiet:#777e8c; --accent:#ad9aff; --accent-bg:#302b48; --green:#75d4a2; --green-bg:#1b3028; --amber:#eac57c; --red:#ef8b8b; width:100%; height:100vh; min-height:760px; display:flex; overflow:hidden; background:var(--page); color:var(--ink); font:14px/1.45 'DM Sans',sans-serif; }\n.workspace * { box-sizing:border-box; }\n.sidebar { width:270px; min-width:270px; display:flex; flex-direction:column; background:var(--sidebar); border-right:1px solid var(--line); }\n.brand-row { height:62px; flex-shrink:0; display:flex; align-items:center; justify-content:space-between; padding:0 15px; border-bottom:1px solid var(--line); }\n.brand-lockup { display:flex; align-items:center; gap:10px; font-size:15px; font-weight:700; letter-spacing:-.03em; }\n.brand-mark { width:25px; height:25px; border-radius:8px; display:grid; place-items:center; color:#d2caff; background:#39324f; font-size:15px; }\n.icon-btn { border:0; background:transparent; color:var(--muted); border-radius:7px; width:34px; height:34px; display:grid; place-items:center; font-size:17px; cursor:pointer; }\n.icon-btn:hover { background:var(--panel-soft); color:var(--ink); }\n.new-chat { width:34px; height:34px; border:1px solid #65598c; border-radius:9px; color:#ede8ff; background:#4c416f; font-size:18px; display:grid; place-items:center; }\n.nav-scroll { flex:1; overflow:auto; padding:17px 11px 12px; }\n.section { margin-bottom:20px; }\n.section-head { display:flex; align-items:center; justify-content:space-between; padding:0 7px 8px; color:#c0c4cc; font-size:12px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; }\n.section-head .left { display:flex; align-items:center; gap:7px; }\n.section-head i { font-size:13px; color:var(--quiet); }\n.project-row { display:flex; align-items:center; gap:8px; height:36px; padding:0 9px; border-radius:7px; color:var(--ink); background:#21242b; font-weight:600; }\n.project-row .path { min-width:0; flex:1; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }\n.project-path { padding:5px 9px 4px 31px; color:var(--quiet); font:11px 'IBM Plex Mono',monospace; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }\n.tree { padding-top:5px; color:#bbc0ca; font-size:13px; }\n.tree-row { display:flex; align-items:center; gap:7px; min-height:27px; padding:3px 7px; border-radius:5px; white-space:nowrap; }\n.tree-row.depth1 { padding-left:23px; }\n.tree-row.depth2 { padding-left:39px; }\n.tree-row.depth3 { padding-left:55px; }\n.tree-row i { width:14px; color:#9097a5; font-size:14px; }\n.tree-row.selected { color:#e3ddff; background:#312d40; }\n.tree-row.selected i { color:var(--accent); }\n.context-count { margin-left:auto; border:1px solid #4a4264; color:#c7baff; background:#28243a; border-radius:20px; padding:1px 7px; font-size:11px; letter-spacing:0; text-transform:none; font-weight:500; }\n.section-divider { border:0; border-top:1px solid #292c34; margin:14px 5px 17px; }\n.chat-row { display:flex; align-items:center; gap:9px; padding:8px 8px; border-radius:7px; color:#c4c8d0; min-height:38px; }\n.chat-row i { font-size:15px; color:#858b98; }\n.chat-row.active { background:#2a2d35; color:#f0f1f5; }\n.chat-row.active i { color:#c7baff; }\n.chat-name { flex:1; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }\n.chat-actions { display:flex; align-items:center; gap:1px; }\n.chat-actions .icon-btn { width:25px; height:27px; font-size:14px; color:#a9aebb; }\n.sidebar-foot { padding:11px 13px; border-top:1px solid var(--line); color:var(--muted); display:flex; gap:9px; align-items:center; font-size:12px; }\n.user-dot { width:26px; height:26px; display:grid; place-items:center; border-radius:50%; background:#35303f; color:#d4caff; font-size:11px; font-weight:700; }\n.main { flex:1; min-width:0; display:flex; flex-direction:column; }\n.topbar { min-height:53px; display:flex; align-items:center; gap:24px; padding:0 23px; border-bottom:1px solid var(--line); background:#15171d; }\n.tabs { display:flex; align-self:stretch; gap:20px; align-items:stretch; }\n.tab { display:flex; align-items:center; gap:8px; padding:0 2px; color:#aeb3bd; border:0; border-bottom:2px solid transparent; background:none; font:500 14px 'DM Sans',sans-serif; }\n.tab i { font-size:16px; }\n.tab.active { color:#e7e2ff; border-bottom-color:var(--accent); }\n.runtime { margin-left:auto; display:flex; align-items:center; gap:11px; color:var(--muted); font-size:12px; white-space:nowrap; }\n.runtime-item { display:flex; align-items:center; gap:7px; }\n.dot { width:7px; height:7px; border-radius:50%; background:var(--green); }\n.sep { width:1px; height:19px; background:var(--line); }\n.runtime .active-model { color:#c9c2ea; font-family:'IBM Plex Mono',monospace; font-size:11px; }\n.refresh { color:#9fa5b0; font-size:16px; }\n.free-ram { height:29px; padding:0 9px; color:#c3c7cf; border:1px solid #414550; border-radius:6px; background:#20232a; font-size:11px; }\n.chat-toolbar { min-height:58px; display:flex; align-items:center; gap:12px; padding:0 28px; border-bottom:1px solid #292c34; }\n.conversation-title { font-size:16px; font-weight:600; letter-spacing:-.02em; }\n.title-context { color:var(--quiet); font-size:12px; display:flex; align-items:center; gap:6px; }\n.toolbar-spacer { flex:1; }\n.agent-mode { display:flex; align-items:center; gap:7px; color:#a9d8bc; font-size:12px; }\n.agent-mode .dot { background:#61bf8c; }\n.quiet-action { border:0; color:#a7adb8; background:transparent; display:flex; align-items:center; gap:6px; padding:6px 8px; border-radius:6px; font-size:12px; }\n.quiet-action i { font-size:15px; }\n.quiet-action:hover { background:#24272e; color:var(--ink); }\n.transcript { flex:1; min-height:0; overflow:auto; padding:23px 32px 22px; }\n.thread { width:min(850px,100%); margin:0 auto; }\n.user-msg { display:flex; flex-direction:row-reverse; align-items:flex-start; gap:10px; margin:0 0 24px auto; }\n.avatar { flex:none; width:28px; height:28px; display:grid; place-items:center; border-radius:50%; background:#39334b; color:#d7cfff; font-size:11px; font-weight:700; }\n.user-col { max-width:80%; }\n.speaker { margin:2px 0 6px; text-align:right; color:#8e95a1; font-size:12px; }\n.user-bubble { color:#edeef2; background:#252832; border:1px solid #343843; padding:12px 15px; border-radius:13px 4px 13px 13px; font-size:14px; line-height:1.6; }\n.agent-wrap { display:flex; gap:11px; align-items:flex-start; margin-bottom:21px; }\n.agent-avatar { width:28px; height:28px; display:grid; place-items:center; flex:none; color:#b7aaff; border:1px solid #5a4e7e; border-radius:9px; font-size:14px; background:#2a2538; }\n.agent-content { flex:1; min-width:0; }\n.agent-name { color:#d1c8ff; font-size:12px; font-weight:600; margin:2px 0 10px; }\n.activity-label { font-size:12px; color:#9ea4b0; margin:0 0 8px; }\n.plan-block { margin-bottom:13px; padding:12px 15px; border:1px solid #353640; border-radius:8px; background:#191b22; }\n.plan-head { display:flex; align-items:center; gap:8px; padding-bottom:8px; border-bottom:1px solid #30323a; color:#d8d1f8; font-weight:600; font-size:13px; }\n.plan-head i { color:#b4a5ff; font-size:16px; }\n.plan-block p { margin:9px 0 0; color:#c5c8d0; font-size:13px; line-height:1.55; }\n.tool-toggle { width:100%; border:0; padding:8px 10px; margin:0 0 6px; background:#202229; border-radius:6px; display:flex; align-items:center; gap:8px; text-align:left; color:#d1d4dc; font-size:12px; }\n.tool-toggle i { color:#b9acff; font-size:15px; }\n.tool-toggle .count { color:#999fac; }\n.tool-toggle .chevron { margin-left:auto; color:#8e94a0; }\n.tool-list { display:none; border-left:1px solid #494455; margin:0 0 14px 13px; padding:2px 0 0 14px; }\n.tool-line { padding:6px 0 8px; color:#c6cad3; font-size:12px; }\n.tool-title { display:flex; align-items:center; gap:8px; font-weight:600; color:#d1caff; }\n.tool-title i { color:#b0a0ff; font-size:14px; }\n.tool-result { padding:5px 0 0 22px; color:#a8b5ae; font:12px/1.5 'IBM Plex Mono',monospace; }\n.diff-block { margin:8px 0 13px; border-top:1px solid #3b3e48; border-bottom:1px solid #3b3e48; }\n.diff-head { height:35px; display:flex; align-items:center; gap:8px; color:#d5d8df; font:12px 'IBM Plex Mono',monospace; }\n.diff-head i { color:#b6a8ff; font-size:15px; }\n.diff-tag { margin-left:auto; color:#a1a6b0; font:11px 'DM Sans',sans-serif; }\n.diff-code { padding:7px 0 10px; background:#14161b; color:#adb2bd; font:12px/1.7 'IBM Plex Mono',monospace; overflow:hidden; }\n.diff-line { display:block; white-space:pre; padding:0 11px; }\n.diff-line.del { background:#351f26; color:#e2a5a7; }\n.diff-line.add { background:#1b3228; color:#a5dbb8; }\n.diff-code>span { display:none; }\n.diff-code::before { content:'  <div className=\"context-row\">\\A-   <span>Context:</span>\\A+   <span>Project context</span>\\A+   <span>This message</span>\\A    {contextFiles.map((file) => (...))}'; display:block; white-space:pre; padding:0 11px; line-height:1.7; color:#adb2bd; font:12px/1.7 'IBM Plex Mono',monospace; }\n.diff-code::before { background:linear-gradient(to bottom, transparent 0 20%, #351f26 20% 40%, #1b3228 40% 80%, transparent 80%); }\n.answer { color:#e6e8ed; font-size:14px; line-height:1.65; margin:12px 0 9px; }\n.answer strong { color:#fff; }\n.answer code { font:12px 'IBM Plex Mono',monospace; color:#d3caff; background:#29253a; padding:2px 5px; border-radius:4px; }\n.review { padding-top:10px; border-top:1px solid #30333c; margin-top:12px; color:#bcc0c9; font-size:13px; line-height:1.6; }\n.review-title { display:flex; align-items:center; gap:7px; color:#c2c8c4; font-weight:600; margin-bottom:4px; }\n.review-title i { color:#83d1a4; font-size:15px; }\n.message-tools { display:flex; gap:10px; color:#969ca8; font-size:11px; margin-top:7px; }\n.message-tools span { display:flex; align-items:center; gap:5px; }\n.composer-wrap { flex:none; background:#15171d; border-top:1px solid #2d3039; padding:12px 28px 10px; }\n.composer { width:min(850px,100%); margin:0 auto; border:1px solid #3b3e48; background:#1d2027; border-radius:14px; box-shadow:0 8px 28px #090a0e55; }\n.context-row { display:flex; gap:7px; align-items:center; flex-wrap:wrap; padding:10px 13px 0; }\n.context-label { color:#9399a5; font-size:11px; margin-right:1px; }\n.chip { display:flex; align-items:center; gap:6px; padding:4px 8px; border-radius:6px; color:#d2caff; border:1px solid #494160; background:#29253a; font:11px 'IBM Plex Mono',monospace; }\n.chip i { color:#a998f0; font-size:13px; }\n.chip .x { color:#a9a1c5; margin-left:2px; font:14px 'DM Sans',sans-serif; }\n.chip.doc { color:#c3d7ca; background:#202d27; border-color:#435749; }\n.chip.doc i { color:#87cba0; }\n.prompt { min-height:58px; padding:11px 14px 9px; color:#9ba1ad; font-size:14px; }\n.composer-bar { min-height:44px; display:flex; align-items:center; gap:5px; border-top:1px solid #30333b; padding:5px 8px; }\n.model-select { display:flex; align-items:center; gap:7px; padding:5px 8px; border:1px solid #414450; border-radius:7px; color:#d3d6de; background:#262931; font:11px 'IBM Plex Mono',monospace; }\n.model-select i { color:#c2b5ff; font-size:14px; }\n.attach { width:31px; height:31px; border:0; background:none; color:#a8adba; display:grid; place-items:center; border-radius:7px; font-size:16px; }\n.attach:hover { background:#2b2e36; }\n.composer-spacer { flex:1; }\n.keyhint { color:#818895; font-size:11px; margin-right:7px; }\n.send { height:32px; padding:0 13px; border:0; border-radius:8px; background:#b9a9ff; color:#17131f; font:600 12px 'DM Sans',sans-serif; display:flex; align-items:center; gap:7px; }\n.send i { font-size:14px; }\n.local-note { width:min(850px,100%); margin:7px auto 0; display:flex; justify-content:center; gap:6px; color:#8f96a1; font-size:11px; }\n.local-note i { color:#80cfa0; font-size:13px; }\n@media (max-width:1100px) { .sidebar{width:235px;min-width:235px}.runtime{gap:7px}.runtime .active-model{display:none}.topbar{gap:15px;padding:0 16px}.chat-toolbar{padding:0 20px}.transcript{padding-left:22px;padding-right:22px}.composer-wrap{padding-left:20px;padding-right:20px} }\n</style>\n<div class=\"workspace\" data-kid=\"1\" data-name=\"ollama workspace layout\">\n    <aside class=\"sidebar\" data-kid=\"1-1\" data-name=\"sidebar container\">\n        <div class=\"brand-row\" data-kid=\"1-1-1\" data-name=\"header brand row\">\n            <div class=\"brand-lockup\" data-kid=\"1-1-1-1\" data-name=\"brand name lockup\">\n                <span class=\"brand-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo mark\">\n                    <i class=\"ti ti-circle-letter-o\" data-kid=\"1-1-1-1-1-1\" data-name=\"o letter icon\">\n                    </i>\n                </span>\n                Ollama UI\n            </div>\n            <button aria-label=\"New chat\" class=\"icon-btn new-chat\" data-kid=\"1-1-1-2\" data-name=\"new chat button\" title=\"New chat\">\n                <i class=\"ti ti-plus\" data-kid=\"1-1-1-2-1\" data-name=\"plus icon\">\n                </i>\n            </button>\n        </div>\n        <div class=\"nav-scroll\" data-kid=\"1-1-2\" data-name=\"navigable sidebar scroll area\">\n            <section class=\"section\" data-kid=\"1-1-2-1\" data-name=\"project section\">\n                <div class=\"section-head\" data-kid=\"1-1-2-1-1\" data-name=\"section header\">\n                    <span class=\"left\" data-kid=\"1-1-2-1-1-1\" data-name=\"header left group\">\n                        <i class=\"ti ti-chevron-down\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"chevron icon\">\n                        </i>\n                        Project\n                    </span>\n                    <button aria-label=\"Open folder\" class=\"icon-btn\" data-kid=\"1-1-2-1-1-2\" data-name=\"open folder button\" title=\"Open folder\">\n                        <i class=\"ti ti-folder-plus\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"folder plus icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"project-row\" data-kid=\"1-1-2-1-2\" data-name=\"project title row\">\n                    <i class=\"ti ti-folder-open\" data-kid=\"1-1-2-1-2-1\" data-name=\"folder open icon\">\n                    </i>\n                    <span class=\"path\" data-kid=\"1-1-2-1-2-2\" data-name=\"project folder name text\">\n                        ollama-ui\n                    </span>\n                    <span class=\"context-count\" data-kid=\"1-1-2-1-2-3\" data-name=\"project file count label\">\n                        2 files\n                    </span>\n                </div>\n                <div class=\"project-path\" data-kid=\"1-1-2-1-3\" data-name=\"project file path text\">\n                    C:\\Users\\PC\\ollama-ui\n                </div>\n                <div class=\"tree\" data-kid=\"1-1-2-1-4\" data-name=\"project file tree\">\n                    <div class=\"tree-row\" data-kid=\"1-1-2-1-4-1\" data-name=\"file tree row\">\n                        <i class=\"ti ti-chevron-down\" data-kid=\"1-1-2-1-4-1-1\" data-name=\"chevron down icon\">\n                        </i>\n                        <i class=\"ti ti-folder\" data-kid=\"1-1-2-1-4-1-2\" data-name=\"folder icon\">\n                        </i>\n                        <span data-kid=\"1-1-2-1-4-1-3\" data-name=\"app directory name\">\n                            app\n                        </span>\n                    </div>\n                    <div class=\"tree-row depth1\" data-kid=\"1-1-2-1-4-2\" data-name=\"file tree row\">\n                        <i class=\"ti ti-chevron-down\" data-kid=\"1-1-2-1-4-2-1\" data-name=\"chevron down icon\">\n                        </i>\n                        <i class=\"ti ti-folder\" data-kid=\"1-1-2-1-4-2-2\" data-name=\"folder icon\">\n                        </i>\n                        <span data-kid=\"1-1-2-1-4-2-3\" data-name=\"components directory name\">\n                            components\n                        </span>\n                    </div>\n                    <div class=\"tree-row depth2 selected\" data-kid=\"1-1-2-1-4-3\" data-name=\"selected file tree row\">\n                        <i class=\"ti ti-file-code\" data-kid=\"1-1-2-1-4-3-1\" data-name=\"code file icon\">\n                        </i>\n                        <span data-kid=\"1-1-2-1-4-3-2\" data-name=\"file name text\">\n                            ChatWindow.tsx\n                        </span>\n                        <span class=\"context-count\" data-kid=\"1-1-2-1-4-3-3\" data-name=\"selected status checkmark\">\n                            ✓\n                        </span>\n                    </div>\n                    <div class=\"tree-row depth2 selected\" data-kid=\"1-1-2-1-4-4\" data-name=\"selected file tree row\">\n                        <i class=\"ti ti-file-code\" data-kid=\"1-1-2-1-4-4-1\" data-name=\"code file icon\">\n                        </i>\n                        <span data-kid=\"1-1-2-1-4-4-2\" data-name=\"file name text\">\n                            FolderTree.tsx\n                        </span>\n                        <span class=\"context-count\" data-kid=\"1-1-2-1-4-4-3\" data-name=\"selected status checkmark\">\n                            ✓\n                        </span>\n                    </div>\n                    <div class=\"tree-row depth1\" data-kid=\"1-1-2-1-4-5\" data-name=\"file tree row\">\n                        <i class=\"ti ti-file-code\" data-kid=\"1-1-2-1-4-5-1\" data-name=\"code file icon\">\n                        </i>\n                        <span data-k