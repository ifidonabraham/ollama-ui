                  <i class=\"icon-file-code\" data-kid=\"1-2-4-1-1-2-1\">\n                        </i>\n                        page.tsx\n                        <span class=\"chip-x\" data-kid=\"1-2-4-1-1-2-2\">\n                            ×\n                        </span>\n                    </span>\n                    <span class=\"context-chip\" data-kid=\"1-2-4-1-1-3\">\n                        <i class=\"icon-file-code\" data-kid=\"1-2-4-1-1-3-1\">\n                        </i>\n                        route.ts\n                        <span class=\"chip-x\" data-kid=\"1-2-4-1-1-3-2\">\n                            ×\n                        </span>\n                    </span>\n                </div>\n                <div class=\"composer\" data-kid=\"1-2-4-1-2\">\n                    <div class=\"composer-input\" data-dynamic=\"true\" data-kid=\"1-2-4-1-2-1\" data-name=\"composer input area\" data-reason=\"text placeholder or input content managed by script\">\n                        Message… · /help for commands · Enter to send\n                    </div>\n                    <div class=\"composer-tools\" data-kid=\"1-2-4-1-2-2\">\n                        <button class=\"model-picker\" data-dynamic=\"true\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"model picker label\" data-reason=\"selected model name updated by script\">\n                            <span class=\"model-dot\" data-kid=\"1-2-4-1-2-2-1-1\">\n                            </span>\n                            qwen2.5-coder\n                            <i class=\"icon-chevron-down\" data-kid=\"1-2-4-1-2-2-1-2\">\n                            </i>\n                        </button>\n                        <span class=\"composer-divider\" data-kid=\"1-2-4-1-2-2-2\">\n                        </span>\n                        <button class=\"attach-btn\" data-kid=\"1-2-4-1-2-2-3\" title=\"Attach image or paste from clipboard\">\n                            <i class=\"icon-image\" data-kid=\"1-2-4-1-2-2-3-1\">\n                            </i>\n                        </button>\n                        <button class=\"attach-btn\" data-kid=\"1-2-4-1-2-2-4\" title=\"Attach document\">\n                            <i class=\"icon-paperclip\" data-kid=\"1-2-4-1-2-2-4-1\">\n                            </i>\n                        </button>\n                        <span class=\"compose-spacer\" data-kid=\"1-2-4-1-2-2-5\">\n                        </span>\n                        <button class=\"send-btn\" data-kid=\"1-2-4-1-2-2-6\">\n                            <i class=\"icon-arrow-up\" data-kid=\"1-2-4-1-2-2-6-1\">\n                            </i>\n                            Send\n                        </button>\n                    </div>\n                </div>\n                <div class=\"privacy\" data-kid=\"1-2-4-1-3\">\n                    <i class=\"icon-shield-check\" data-kid=\"1-2-4-1-3-1\">\n                    </i>\n                    Running locally via Ollama · no data leaves your machine\n                </div>\n            </div>\n        </footer>\n    </section>\n</main>\n",
