      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n</style>\n<div class=\"h-screen w-full overflow-hidden bg-[#0b100f] text-[#e6eee9]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'DM Sans',sans-serif;\">\n    <div class=\"flex h-full min-w-0\" data-kid=\"1-1\" data-name=\"main application shell\">\n        <aside class=\"flex w-[272px] shrink-0 flex-col border-r border-[#26312e] bg-[#111816]\" data-kid=\"1-1-1\" data-name=\"sidebar navigation panel\">\n            <div class=\"flex h-[62px] shrink-0 items-center justify-between border-b border-[#26312e] px-5\" data-kid=\"1-1-1-1\" data-name=\"workspace header\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1-1\" data-name=\"workspace branding group\">\n                    <div class=\"flex h-8 w-8 items-center justify-center rounded-[10px] border border-[#426b5b] bg-[#1b2a24] text-[15px] font-semibold text-[#a9e0c4]\" data-kid=\"1-1-1-1-1-1\" data-name=\"workspace icon\">\n                        O\n                    </div>\n                    <div data-kid=\"1-1-1-1-1-2\" data-name=\"workspace title and description\">\n                        <div class=\"text-[14px] font-semibold tracking-[-0.02em] text-[#f1f6f2]\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"workspace title text\">\n                            Ollama UI\n                        </div>\n                        <div class=\"mt-0.5 text-[11px] text-[#9baaa2]\" data-kid=\"1-1-1-1-1-2-2\" data-name=\"workspace description text\">\n                            Local coding workspace\n                        </div>\n                    </div>\n                </div>\n                <button aria-label=\"New chat\" class=\"flex h-9 w-9 items-center justify-center rounded-lg border border-[#40564c] bg-[#22352d] text-[#b9ebd0]\" data-kid=\"1-1-1-1-2\" data-name=\"new chat button\" title=\"New chat\">\n                    <i class=\"bi bi-plus-lg text-[17px]\" data-kid=\"1-1-1-1-2-1\" data-name=\"plus icon\" style=\"color:#b9ebd0;width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"shrink-0 px-4 pt-4\" data-kid=\"1-1-1-2\" data-name=\"project context selector\">\n                <div class=\"mb-2 flex h-8 items-center justify-between px-1\" data-kid=\"1-1-1-2-1\" data-name=\"project dropdown container\">\n                    <button class=\"flex items-center gap-2 text-[12px] font-semibold text-[#d9e3dd]\" data-kid=\"1-1-1-2-1-1\" data-name=\"project selector button\">\n                        <i class=\"bi bi-chevron-down text-[10px]\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"chevron icon\" style=\"color:#9baaa2;width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Project\n                    </button>\n                    <button aria-label=\"Open folder\" class=\"flex h-8 w-8 items-center justify-center rounded-md text-[#a7b5ad]\" data-kid=\"1-1-1-2-1-2\" data-name=\"open folder button\" title=\"Open folder\">\n                        <i class=\"bi bi-folder2-open text-[15px]\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"open folder icon\" style=\"color:#a7b5ad;width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"mb-2 flex items-center gap-2 rounded-md px-1 py-1\" data-kid=\"1-1-1-2-2\" data-name=\"selected project info\">\n                    <i class=\"bi bi-folder-fill text-[13px]\" data-kid=\"1-1-1-2-2-1\" data-name=\"folder icon\" style=\"color:#9fd4b6;width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"min-w-0 flex-1 truncate text-[13px] font-semibold text-[#e6eee9]\" data-kid=\"1-1-1-2-2-2\" data-name=\"project name text\">\n                        ollama-ui\n                    </span>\n                    <span class=\"rounded-full bg-[#24382f] px-2 py-0.5 text-[11px] font-medium text-[#b7e3c9]\" data-kid=\"1-1-1-2-2-3\" data-name=\"selection count badge\">\n                        2 selected\n                    </span>\n                    <button aria-label=\"Close folder\" class=\"flex h-7 w-7 items-center justify-center rounded text-[#9baaa2]\" data-kid=\"1-1-1-2-2-4\" data-name=\"close folder button\" title=\"Close folder\">\n                        <i class=\"bi bi-x-lg text-[12px]\" data-kid=\"1-1-1-2-2-4-1\" data-name=\"close icon\" style=\"color:#9baaa2;width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"min-h-0 flex-1 overflow-y-auto px-3 pb-4\" data-kid=\"1-1-1-3\" data-name=\"file tree explorer\">\n                <div class=\"space-y-0.5 font-mono text-[12px]\" data-kid=\"1-1-1-3-1\" data-name=\"project file structure\" style=\"font-family:'IBM Plex Mono',monospace\">\n                    <div class=\"flex h-7 items-center gap-2 rounded-md px-2 text-[#c8d4cd]\" data-kid=\"1-1-1-3-1-1\" data-name=\"app folder entry\">\n                        <i class=\"bi bi-chevron-down text-[9px]\" data-kid=\"1-1-1-3-1-1-1\" data-name=\"app folder chevron icon\" style=\"color:#83958b;width:11px;height:11px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"bi bi-folder-fill text-[12px]\" data-kid=\"1-1-1-3-1-1-2\" data-name=\"app folder icon\" style=\"color:#91b7a0;width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-1-1-3\" data-name=\"app folder text\">\n                            app\n                        </span>\n                    </div>\n                    <div class=\"ml-5 flex h-7 items-center gap-2 rounded-md px-2 text-[#aebdb4]\" data-kid=\"1-1-1-3-1-2\" data-name=\"api folder entry\">\n                        <i class=\"bi bi-chevron-down text-[9px]\" data-kid=\"1-1-1-3-1-2-1\" data-name=\"api folder chevron icon\" style=\"color:#83958b;width:11px;height:11px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"bi bi-folder-fill text-[12px]\" data-kid=\"1-1-1-3-1-2-2\" data-name=\"api folder icon\" style=\"color:#91b7a0;width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-1-2-3\" data-name=\"api folder text\">\n                            api\n                        </span>\n                    </div>\n                    <div class=\"ml-10 flex h-7 items-center gap-2 rounded-md px-2 text-[#9eaea5]\" data-kid=\"1-1-1-3-1-3\" data-name=\"agent directory entry\">\n                        <span class=\"w-[11px]\" data-kid=\"1-1-1-3-1-3-1\" data-name=\"spacer\">\n                        </span>\n                        <span class=\"text-[#c0d0c6]\" data-kid=\"1-1-1-3-1-3-2\" data-name=\"agent directory bullet\">\n                            ◦\n                        </span>\n                        <span data-kid=\"1-1-1-3-1-3-3\" data-name=\"agent directory text\">\n                            agent/\n                        </span>\n                    </div>\n                    <div class=\"ml-10 flex h-7 items-center gap-2 rounded-md px-2 text-[#9eaea5]\" data-kid=\"1-1-1-3-1-4\" data-name=\"chat directory entry\">\n                        <span class=\"w-[11px]\" data-kid=\"1-1-1-3-1-4-1\" data-name=\"spacer\">\n                        </span>\n                        <span class=\"text-[#c0d0c6]\" data-kid=\"1-1-1-3-1-4-2\" data-name=\"chat directory bullet\">\n                            ◦\n                        </span>\n                        <span data-kid=\"1-1-1-3-1-4-3\" data-name=\"chat directory text\">\n                            chat/\n                        </span>\n                    </div>\n                    <div class=\"ml-5 flex h-7 items-center gap-2 rounded-md px-2 text-[#aebdb4]\" data-kid=\"1-1-1-3-1-5\" data-name=\"components folder entry\">\n                        <i class=\"bi bi-chevron-down text-[9px]\" data-kid=\"1-1-1-3-1-5-1\" data-name=\"components folder chevron\" style=\"color:#83958b;width:11px;height:11px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"bi bi-folder-fill text-[12px]\" data-kid=\"1-1-1-3-1-5-2\" data-name=\"components folder icon\" style=\"color:#91b7a0;width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-1-5-3\" data-name=\"components folder text\">\n                            components\n                        </span>\n                    </div>\n                    <div class=\"ml-10 flex h-7 items-center gap-2 rounded-md px-2 text-[#aab9b0]\" data-kid=\"1-1-1-3-1-6\" data-name=\"ChatWindow file entry\">\n                        <span class=\"w-[11px]\" data-kid=\"1-1-1-3-1-6-1\" data-name=\"spacer\">\n                        </span>\n                        <span class=\"text-[#a7c4b1]\" data-kid=\"1-1-1-3-1-6-2\" data-name=\"typescript icon\">\n                            TS\n                        </span>\n                        <span data-kid=\"1-1-1-3-1-6-3\" data-name=\"ChatWindow file name\">\n                            ChatWindow.tsx\n                        </span>\n                    </div>\n                    <div class=\"ml-10 flex h-7 items-center gap-2 rounded-md px-2 text-[#aab9b0]\" data-kid=\"1-1-1-3-1-7\" data-name=\"Sidebar file entry\">\n                        <span class=\"w-[11px]\" data-kid=\"1-1-1-3-1-7-1\" data-name=\"spacer\">\n                        </span>\n                        <span class=\"text-[#a7c4b1]\" data-kid=\"1-1-1-3-1-7-2\" data-name=\"typescript icon\">\n                            TS\n                        </span>\n                        <span data-kid=\"1-1-1-3-1-7-3\" data-name=\"Sidebar file name\">\n                            Sidebar.tsx\n                        </span>\n                    </div>\n                    <div class=\"ml-5 flex h-7 items-center gap-2 rounded-md px-2 text-[#aebdb4]\" data-kid=\"1-1-1-3-1-8\" data-name=\"lib folder entry\">\n                        <i class=\"bi bi-chevron-down text-[9px]\" data-kid=\"1-1-1-3-1-8-1\" data-name=\"lib folder chevron\" style=\"color:#83958b;width:11px;height:11px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"bi bi-folder-fill text-[12px]\" data-kid=\"1-1-1-3-1-8-2\" data-name=\"lib folder icon\" style=\"color:#91b7a0;width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-1-8-3\" data-name=\"lib folder text\">\n                            lib\n                        </span>\n                    </div>\n                    <div class=\"ml-10 flex h-7 items-center gap-2 rounded-md px-2 text-[#aab9b0]\" data-kid=\"1-1-1-3-1-9\" data-name=\"intent file entry\">\n                        <span class=\"w-[11px]\" data-kid=\"1-1-1-3-1-9-1\" data-name=\"spacer\">\n                        </span>\n                        <span class=\"text-[#a7c4b1]\" data-kid=\"1-1-1-3-1-9-2\" data-name=\"typescript icon\">\n                            TS\n                        </span>\n                        <span data-kid=\"1-1-1-3-1-9-3\" data-name=\"intent file name\">\n                            intent.ts\n                        </span>\n                    </div>\n                    <div class=\"mt-1 flex h-7 items-center gap-2 rounded-md bg-[#20352b] px-2 text-[#c7f0d5]\" data-kid=\"1-1-1-3-1-10\" data-name=\"page file entry\">\n                        <span class=\"w-[11px]\" data-kid=\"1-1-1-3-1-10-1\" data-name=\"spacer\">\n                        </span>\n                        <span class=\"text-[#a7c4b1]\" data-kid=\"1-1-1-3-1-10-2\" data-name=\"typescript icon\">\n                            TS\n                        </span>\n                        <span data-kid=\"1-1-1-3-1-10-3\" data-name=\"page file name\">\n                            page.tsx\n                        </span>\n                        <i class=\"bi bi-check2 ml-auto text-[12px]\" data-kid=\"1-1-1-3-1-10-4\" data-name=\"checkmark icon\" style=\"color:#a9e0c4;width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"flex h-7 items-center gap-2 rounded-md bg-[#20352b] px-2 text-[#c7f0d5]\" data-kid=\"1-1-1-3-1-11\" data-name=\"globals file entry\">\n                        <span class=\"w-[11px]\" data-kid=\"1-1-1-3-1-11-1\" data-name=\"spacer\">\n                        </span>\n                        <span class=\"text-[#b7c798]\" data-kid=\"1-1-1-3-1-11-2\" data-name=\"css file icon\">\n                            #\n                        </span>\n                        <span data-kid=\"1-1-1-3-1-11-3\" data-name=\"globals file name\">\n                            globals.css\n                        </span>\n                        <i class=\"bi bi-check2 ml-auto text-[12px]\" data-kid=\"1-1-1-3-1-11-4\" data-name=\"checkmark icon\" style=\"color:#a9e0c4;width:14px;heigh