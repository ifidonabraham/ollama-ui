    "var_ec95dde87a78": {
      "type": "variant",
      "label": "01 · Conversation workbench",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;650;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n.shell { --bg: #101311; --sidebar: #141815; --panel: #171c18; --surface: #1b211d; --surface-2: #202822; --line: #2b342e; --line-soft: #222a25; --ink: #edf1ec; --soft: #b3beb5; --muted: #87958a; --faint: #68766c; --mint: #a9e2c0; --mint-dim: #20382b; --mint-border: #385b44; --blue: #9bbfe8; --red: #e48d82; height: 100vh; min-height: 790px; width: 100%; display: flex; overflow: hidden; background: var(--bg); color: var(--ink); font: 14px/1.45 'DM Sans', system-ui, sans-serif; }\n.shell button { font: inherit; color: inherit; }\n.sidebar { width: 270px; min-width: 270px; height: 100%; display: flex; flex-direction: column; background: var(--sidebar); border-right: 1px solid var(--line); }\n.brandbar { height: 58px; padding: 0 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line-soft); }\n.brand { display: flex; align-items: center; gap: 10px; font-weight: 650; font-size: 14px; letter-spacing: -.02em; }\n.brandmark { width: 27px; height: 27px; border-radius: 8px 8px 8px 3px; background: var(--mint); color: #17241b; display: grid; place-items: center; font: 700 12px 'IBM Plex Mono', monospace; letter-spacing: -.07em; }\n.newchat { width: 31px; height: 31px; border: 1px solid #53695a; border-radius: 8px; background: #223128; display: grid; place-items: center; color: var(--mint); cursor: pointer; }\n.side-scroll { min-height: 0; flex: 1; overflow-y: auto; }\n.section { padding: 17px 13px 0; }\n.section-head { height: 25px; display: flex; align-items: center; justify-content: space-between; color: var(--soft); font-size: 12px; font-weight: 600; letter-spacing: .02em; }\n.section-title { display: flex; align-items: center; gap: 6px; }\n.quiet-btn { border: 0; background: transparent; color: var(--muted); width: 27px; height: 27px; border-radius: 6px; display: grid; place-items: center; cursor: pointer; }\n.quiet-btn:hover { background: var(--surface-2); color: var(--ink); }\n.project-path { margin: 8px 2px 10px; border: 1px solid var(--line); border-radius: 8px; background: #171e19; padding: 9px 9px 8px; }\n.project-top { display: flex; align-items: center; gap: 8px; }\n.project-icon { color: var(--mint); font-size: 15px; }\n.project-name { min-width: 0; flex: 1; font-size: 13px; font-weight: 600; }\n.project-sub { margin: 3px 0 0 23px; color: var(--muted); font: 10.5px 'IBM Plex Mono', monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.tree { margin: 3px 0 1px; padding: 0 0 0 2px; }\n.tree-row { height: 28px; display: flex; align-items: center; gap: 7px; border-radius: 5px; color: var(--soft); padding: 0 7px; font-size: 12px; white-space: nowrap; }\n.tree-row.depth1 { padding-left: 20px; }\n.tree-row.depth2 { padding-left: 39px; }\n.tree-row.open { color: var(--ink); }\n.tree-row.selected { color: var(--mint); background: #1c2b21; }\n.tree-row .name { flex: 1; overflow: hidden; text-overflow: ellipsis; }\n.tree-row .ext { color: var(--faint); font: 10px 'IBM Plex Mono', monospace; }\n.check { width: 14px; height: 14px; border: 1px solid #5f8a6b; border-radius: 4px; background: #20382b; color: var(--mint); display: grid; place-items: center; font-size: 10px; }\n.context-count { margin: 7px 4px 0; color: var(--muted); font-size: 11px; }\n.context-count strong { color: var(--mint); font-weight: 600; }\n.section-divider { margin-top: 15px; border-top: 1px solid var(--line-soft); }\n.chats-head { padding: 14px 15px 6px; display: flex; align-items: center; justify-content: space-between; color: var(--soft); font-size: 12px; font-weight: 600; }\n.chat-list { padding: 2px 7px 14px; }\n.chat-row { display: flex; align-items: center; gap: 9px; min-height: 48px; margin: 2px 0; padding: 6px 8px; border-radius: 7px; color: var(--soft); }\n.chat-row.active { background: #202922; color: var(--ink); }\n.chat-mark { width: 7px; height: 7px; border: 1px solid #718075; border-radius: 50%; flex: 0 0 auto; }\n.chat-row.active .chat-mark { border: 2px solid var(--mint); background: transparent; }\n.chat-meta { min-width: 0; flex: 1; }\n.chat-name { font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.chat-model { margin-top: 2px; color: var(--muted); font: 10px 'IBM Plex Mono', monospace; }\n.row-actions { display: flex; gap: 1px; color: var(--muted); }\n.row-actions i { width: 20px; height: 20px; display: grid; place-items: center; font-size: 12px; }\n.sidebar-foot { padding: 12px 14px; border-top: 1px solid var(--line-soft); display: flex; align-items: center; gap: 9px; color: var(--soft); font-size: 12px; }\n.user-avatar { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 50%; background: #303b33; color: #d4dfd5; font-size: 10px; font-weight: 600; }\n.main { min-width: 0; flex: 1; display: flex; flex-direction: column; height: 100%; }\n.appbar { height: 56px; flex: 0 0 auto; padding: 0 21px; display: flex; align-items: center; gap: 18px; background: #121613; border-bottom: 1px solid var(--line); }\n.tabs { display: flex; align-items: center; gap: 4px; height: 100%; }\n.tab { height: 100%; position: relative; display: inline-flex; align-items: center; gap: 8px; padding: 0 12px; border: 0; background: transparent; color: var(--muted); font-size: 13px; cursor: pointer; }\n.tab i { font-size: 15px; }\n.tab.active { color: var(--ink); font-weight: 600; }\n.tab.active:after { content: ''; position: absolute; bottom: -1px; left: 11px; right: 11px; height: 2px; border-radius: 2px 2px 0 0; background: var(--mint); }\n.app-spacer { flex: 1; }\n.runtime { display: flex; align-items: center; gap: 10px; color: var(--soft); font-size: 12px; }\n.runtime-status { display: flex; align-items: center; gap: 7px; white-space: nowrap; }\n.status-dot { width: 7px; height: 7px; border-radius: 50%; background: #7fcea0; box-shadow: 0 0 0 3px #7fcea01a; }\n.runtime-count { color: var(--muted); }\n.runtime-divider { height: 18px; width: 1px; background: var(--line); }\n.refresh-btn { background: transparent; border: 0; color: var(--muted); width: 26px; height: 28px; border-radius: 6px; display: grid; place-items: center; cursor: pointer; }\n.free-ram { height: 29px; padding: 0 10px; border: 1px solid #465349; border-radius: 6px; background: transparent; color: #c4d2c7; font-size: 11px; cursor: pointer; }\n.chatbar { height: 49px; flex: 0 0 auto; padding: 0 26px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--line-soft); background: #141915; }\n.chat-title { font-size: 13px; color: var(--ink); font-weight: 600; }\n.chat-subtitle { color: var(--muted); font-size: 12px; }\n.chatbar-space { flex: 1; }\n.sys-btn { display: flex; align-items: center; gap: 7px; height: 30px; padding: 0 10px; border: 1px solid var(--line); border-radius: 6px; background: transparent; color: var(--soft); font-size: 12px; cursor: pointer; }\n.agent-label { display: flex; align-items: center; gap: 7px; color: var(--soft); font-size: 12px; }\n.agent-glyph { width: 18px; height: 18px; display: grid; place-items: center; border-radius: 5px; background: #26392c; color: var(--mint); font-size: 11px; }\n.clear-btn { display: flex; align-items: center; gap: 6px; padding: 5px 8px; border: 0; background: transparent; color: var(--muted); font-size: 12px; cursor: pointer; border-radius: 6px; }\n.clear-btn:hover { color: #f3aca0; background: #2a1d1b; }\n.transcript { min-height: 0; flex: 1; overflow: auto; padding: 10px 28px 6px; }\n.thread { max-width: 900px; margin: 0 auto; }\n.turn { margin: 0 0 6px; }\n.user-turn { display: flex; justify-content: flex-end; }\n.user-bubble { max-width: 77%; padding: 7px 12px; border-radius: 12px 12px 3px 12px; background: #21342a; color: #e3eee5; font-size: 13px; line-height: 1.4; }\n.user-meta { display: flex; justify-content: flex-end; gap: 7px; color: var(--muted); font-size: 11px; margin: 0 4px 3px; }\n.agent-turn { display: grid; grid-template-columns: 28px minmax(0,1fr); gap: 11px; margin-bottom: 6px; }\n.agent-avatar { width: 27px; height: 27px; margin-top: 2px; display: grid; place-items: center; border: 1px solid #44664d; border-radius: 8px 8px 8px 3px; color: var(--mint); font: 600 10px 'IBM Plex Mono', monospace; background: #1a281e; }\n.agent-content { min-width: 0; }\n.agent-heading { display: flex; align-items: center; gap: 8px; margin: 2px 0 3px; color: var(--ink); font-size: 12px; font-weight: 600; }\n.agent-heading .detail { color: var(--muted); font-size: 11px; font-weight: 400; }\n.plan-block { padding: 5px 10px 6px; border-left: 2px solid #536b58; background: #171e19; border-radius: 0 7px 7px 0; }\n.block-label { display: flex; align-items: center; gap: 7px; margin-bottom: 1px; color: #c4d4c7; font-size: 12px; font-weight: 600; }\n.block-label i { color: #a4c7ad; font-size: 14px; }\n.plan-copy { color: var(--soft); font-size: 12px; line-height: 1.35; }\n.plan-copy strong { color: var(--ink); font-weight: 500; }\n.activity-head { display: flex; align-items: center; gap: 8px; padding: 0 0 2px; color: var(--soft); font-size: 12px; }\n.activity-count { display: inline-flex; align-items: center; gap: 6px; color: var(--soft); font-weight: 500; }\n.activity-count i { color: #c5d2c8; font-size: 14px; }\n.expanded-mark { color: var(--muted); margin-left: 1px; font-size: 10px; }\n.tool-list { border-left: 1px solid #354039; margin-left: 7px; padding: 0 0 1px 15px; }\n.tool-row { display: grid; grid-template-columns: 18px 1fr; gap: 8px; padding: 2px 0; }\n.tool-icon { color: #96bba0; font-size: 13px; padding-top: 1px; }\n.tool-body { min-width: 0; }\n.tool-title { display: flex; align-items: center; gap: 8px; color: var(--ink); font-size: 12px; }\n.tool-name { font: 500 11px 'IBM Plex Mono', monospace; color: #b8d9c1; }\n.tool-path { color: var(--muted); font: 10.5px 'IBM Plex Mono', monospace; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }\n.tool-result { margin-top: 0; color: var(--muted); font-size: 10.5px; }\n.diff { margin: 2px 0 3px; overflow: hidden; border: 1px solid #354039; border-radius: 8px; background: #121713; }\n.diff-head { min-height: 27px; padding: 0 11px; display: flex; align-items: center; gap: 8px; background: #1b221d; border-bottom: 1px solid #303a33; }\n.diff-file { color: #dce6dd; font: 11px 'IBM Plex Mono', monospace; }\n.diff-kind { color: var(--muted); font-size: 10.5px; }\n.diff-spacer { flex: 1; }\n.diff-disclosure { color: var(--muted); font-size: 10px; }\n.diff-body { padding: 2px 0 3px; font: 11px/1.25 'IBM Plex Mono', monospace; overflow: auto; }\n.diff-line { display: flex; gap: 12px; height: 16px; min-height: 16px; line-height: 16px; padding: 0 12px; white-space: pre; color: #a8b4aa; }\n.diff-line .ln { width: 17px; flex: 0 0 17px; color: #6d796f; text-align: right; }\n.diff-line.add { color: #a9d7b5; background: #1c3224; }\n.diff-line.del { color: #e2a198; background: #341f1e; }\n.review-block { margin-top: 2px; padding: 5px 9px; border: 1px solid #344139; border-radius: 7px; background: #171d19; }\n.review-head { display: flex; align-items: center; gap: 7px; color: #d2e0d4; font-size: 11.5px; font-weight: 600; }\n.review-head i { color: #a9cdb2; font-size: 13px; }\n.review-copy { margin-top: 1px; color: var(--soft); font-size: 11.5px; line-height: 1.35; }\n.final-copy { margin-top: 3px; color: #e1e8e2; font-size: 12.5px; line-height: 1.4; }\n.final-copy code { padding: 1px 4px; border-radius: 3px; background: #252d27; color: #c5ddca; font: 11px 'IBM Plex Mono', monospace; }\n.final-tail { display: flex; align-items: center; gap: 7px; margin-top: 2px; color: var(--muted); font-size: 10.5px; }\n.final-tail .tiny-dot { width: 5px; height: 5px; border-radius: 50%; background: #85c99a; }\n.composer-area { flex: 0 0 auto; padding: 10px 28px 9px; border-top: 1px solid var(--line); background: #131814; }\n.composer-wrap { max-width: 900px; margin: 0 auto; }\n.context-row { min-height: 27px; display: flex; align-items: center; gap: 6px; margin: 0 0 7px 1px; }\n.context-label { color: var(--muted); font-size: 11px; margin-right: 3px; }\n.context-chip { display: inline-flex; align-items: center; gap: 6px; min-height: 23px; padding: 2px 7px; border: 1px solid #37503e; border-radius: 5px; background: #1c2a20; color: #c0dec6; font: 10.5px 'IBM Plex Mono', monospace; }\n.context-chip i { color: #9fc4a7; font-size: 11px; }\n.chip-x { color: #8da693; font-size: 10px; margin-left: 1px; }\n.composer { border: 1px solid #3a463d; border-radius: 11px; background: #1b211d; box-shadow: 0 7px 22px #00000022; }\n.composer-input { height: 52px; padding: 13px 14px 8px; color: #79867c; font-size: 13px; }\n.composer-tools { height: 41px; padding: 0 9px; display: flex; align-items: center; gap: 5px; border-top: 1px solid #2b342e; }\n.model-picker { height: 27px; display: flex; align-items: center; gap: 7px; padding: 0 8px; border: 1px solid #364138; border-radius: 6px; background: #202822; color: #d0ddd2; font-size: 11px; cursor: pointer; }\n.model-dot { width: 7px; height: 7px; border-radius: 50%; background: #a5d6b4; }\n.model-picker .icon-chevron-down { font-size: 11px; color: var(--muted); }\n.composer-divider { height: 16px; width: 1px; margin: 0 3px; background: #354039; }\n.attach-btn { width: 29px; height: 29px; display: grid; place-items: center; border: 0; border-radius: 6px; background: transparent; color: #a5b1a7; font-size: 15px; cursor: pointer; }\n.attach-btn:hover { background: #28312b; }\n.compose-spacer { flex: 1; }\n.send-btn { height: 29px; display: inline-flex; align-items: center; gap: 7px; padding: 0 12px; border: 0; border-radius: 7px; background: #a8dfbb; color: #17241b !important; font-size: 12px !important; font-weight: 650 !important; cursor: pointer; }\n.send-btn i { font-size: 13px; }\n.privacy { margin: 6px auto 0; color: #819087; text-align: center; font-size: 10.5px; }\n.privacy i { color: #92bd9d; font-size: 11px; vertical-align: -1px; margin-right: 3px; }\n@media (max-width: 900px) { .sidebar { width: 220px; min-width: 220px; } .runtime-count { display: none; } .chatbar { padding: 0 16px; } .transcript { padding-left: 16px; padding-right: 16px; } .composer-area { padding-left: 16px; padding-right: 16px; } }\n</style>\n<main class=\"shell\" data-kid=\"1\">\n    <aside class=\"sidebar\" data-kid=\"1-1\">\n        <header class=\"brandbar\" data-kid=\"1-1-1\">\n            <div class=\"brand\" data-kid=\"1-1-1-1\">\n                <span class=\"brandmark\" data-kid=\"1-1-1-1-1\">\n                    ol\n                </span>\n                <span data-kid=\"1-1-1-1-2\">\n                    Ollama UI\n                </span>\n            </div>\n            <button class=\"newchat\" data-kid=\"1-1-1-2\" title=\"New chat\">\n                <i class=\"icon-plus\" data-kid=\"1-1-1-2-1\">\n                </i>\n            </button>\n        </header>\n        <div class=\"side-scroll\" data-kid=\"1-1-2\">\n            <section class=\"section\" data-kid=\"1-1-2-1\">\n                <div class=\"section-head\" data-kid=\"1-1-2-1-1\">\n                    <span class=\"section-title\" data-kid=\"1-1-2-1-1-1\">\n                        <i class=\"icon-chevron-down\" data-kid=\"1-1-2-1-1-1-1\">\n                        </i>\n                        Project\n                    </span>\n                    <button class=\"quiet-btn\" data-kid=\"1-1-2-1-1-2\" title=\"Open folder\">\n                        <i class=\"icon-folder-open\" data-kid=\"1-1-2-1-1-2-1\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"project-path\" data-kid=\"1-1-2-1-2\">\n                    <div class=\"project-top\" data-kid=\"1-1-2-1-2-1\">\n                        <i class=\"icon-folder-open project-icon\" data-