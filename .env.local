# Ollama host configuration
# ─────────────────────────────────────────────────────────────────────────────
# Leave blank to use local Ollama (127.0.0.1:11434)
# Set to your Azure/cloud Ollama URL to run models in the cloud:
#   OLLAMA_HOST=http://your-azure-container.region.azurecontainer.io:11434
#
# The app tries the configured host first, then falls back to local Ollama.
# ─────────────────────────────────────────────────────────────────────────────

OLLAMA_HOST=
